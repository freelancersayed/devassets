# ==============================================
# DevAssets Backend Environment Configuration
# ==============================================

# MongoDB Connection String (Atlas or Localhost)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/DevAssets?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_password@cluster0.mongodb.net/DevAssets?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://admin:your_password@cluster0.mongodb.net/DevAssets?retryWrites=true&w=majority
DB_NAME=DevAssets

# FastSpring Payment Gateway
FASTSPRING_WEBHOOK_SECRET=your_fastspring_hmac_secret_key_here
NEXT_PUBLIC_FASTSPRING_STOREFRONT=devassets.test.onfastspring.com/popup-devassets

# Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=devassets-secure-fallback-secret-minimum-32-chars
